# ApplyPilot environment variables
# Copy to `.env.local` and fill in only what you need.
# The app runs fully in demo mode with NONE of these set.

# Public base URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional) -----------------------------------------------------
# Set BOTH of these to switch from demo storage to Supabase persistence.
# Leave them blank to keep using the seeded in-memory demo workspace.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Server-side only. Not required for normal operation because every
# table is protected by row-level security and read through the user's session.
# Only set this if you add an admin/maintenance task that genuinely needs it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI coaching (optional) --------------------------------------------------
# Without a key, ApplyPilot uses a deterministic offline coach that only
# reflects text you typed. It never invents accomplishments.
ANTHROPIC_API_KEY=

# "anthropic" | "mock". Defaults to "anthropic" when ANTHROPIC_API_KEY is set,
# otherwise "mock". Set to "mock" to force the offline coach.
AI_PROVIDER=

# Model used when AI_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Demo mode ---------------------------------------------------------------
# "true" forces the seeded demo workspace even if Supabase is configured.
DEMO_MODE=

# --- Local file storage (the desktop build) ----------------------------------
# Set BOTH to run ApplyPilot as a single-user app that keeps everything in one
# JSON file on this machine. The Electron shell sets these itself; you only need
# them to run the desktop storage mode from a terminal.
#
# In this mode there is no sign-in — the operating system account is the
# boundary — so the server must stay bound to 127.0.0.1. Do not use it for a
# deployment anyone else can reach.
APPLYPILOT_STORAGE=
APPLYPILOT_DATA_FILE=
